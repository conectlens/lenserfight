# apps/gateway — local BYOK gateway daemon (routes AI provider calls from the
# CLI/desktop to local or cloud providers on the lenser's own machine).
#
# Supabase credentials (SUPABASE_URL, SUPABASE_ANON_KEY) are shared with the
# rest of the platform and documented in the root .env.example — set them
# there, not here.

# ─── Auth (health/readiness probes) ────────────────────────────────────────────
# At least one of these lets the gateway's own health checks authenticate
# against the platform API; neither is required to run the gateway itself.
# LENSERFIGHT_API_KEY=your-developer-api-key
# LF_ACCESS_TOKEN=your-access-token
# SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# ─── Lenser profile selection ──────────────────────────────────────────────────
# LF_PROFILE=default

# ─── Kill switches (health probe reporting only, default off) ─────────────────
# LF_GATEWAY_GLOBAL_KILL_SWITCH=1
# LF_GATEWAY_OWNER_PAUSED=1

# ─── Local dev / test only — never set in production ──────────────────────────
# Skips webhook signature verification. Real signature checks stay off by
# default in dev; this only matters if you've turned them on locally.
# LF_GATEWAY_SKIP_SIG_VERIFY=true
