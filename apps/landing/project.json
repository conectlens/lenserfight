{
  "name": "landing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/landing/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "layer:app",
    "scope:marketing",
    "surface:landing",
    "license:oss"
  ],
  "// targets": "to see all targets run: nx show project landing",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/landing",
        "command": "vite build && node ../../tools/seo/generate-app-seo.mjs landing"
      },
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": ["vite"]
        }
      ],
      "outputs": ["{workspaceRoot}/dist/apps/landing"]
    }
  }
}
