# apps/worker — background job runner (battles, workflows, async media, webhooks).
#
# Supabase credentials (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY)
# are shared with the rest of the platform and documented in the root .env.example
# ("Supabase (server — platform-api, workers)" section) — set them there, not here.
#
# Every var below has a working default; nothing here is required to start the
# worker. They're feature toggles and tuning knobs, not startup requirements.

# ─── Worker loop feature toggles ───────────────────────────────────────────────
# Opt-in (default disabled):
# PLATFORM_API_BATTLE_WORKER_ENABLED=true
# PLATFORM_API_SCHEDULED_WORKFLOW_WORKER_ENABLED=true
# PLATFORM_API_TEAM_RUN_WORKER_ENABLED=true
# Opt-out (default enabled, set to "false" to disable):
# PLATFORM_API_WORKFLOW_RECOVERY_ENABLED=false
# PLATFORM_API_VOTE_ANOMALY_WORKER_ENABLED=false
# PLATFORM_API_AUTO_PROMOTE_WORKER_ENABLED=false
# PLATFORM_API_BATTLE_FINALIZE_WORKER_ENABLED=false
# PLATFORM_API_WORKFLOW_DISPATCH_ENABLED=false
# PLATFORM_API_WEBHOOK_DRAIN_ENABLED=false
# PLATFORM_API_ASYNC_MEDIA_POLL_ENABLED=false
# CHAINABIT_EXECUTION_ENABLED=false

# ─── Health monitoring ──────────────────────────────────────────────────────────
# FEATURE_WORKER_HEALTH_MONITORING=true
# WORKER_HEALTH_PORT=9090
# WORKER_HEALTH_TOKEN=your-health-check-bearer-token
# WORKER_HEARTBEAT_INTERVAL_MS=10000

# ─── Worker identity (defaults to a per-process id; set explicitly for multi-instance deploys) ─
# BATTLE_WORKER_ID=worker-1
# ASYNC_POLL_WORKER_ID=async-poll-1
# TEAM_RUN_WORKER_ID=team-run-worker-1

# ─── Timeouts & polling intervals (ms unless noted) ────────────────────────────
# WORKER_PROVIDER_TIMEOUT_MS=120000
# WORKER_WORKFLOW_TIMEOUT_MS=600000
# WORKER_WORKFLOW_HEARTBEAT_MS=15000
# WORKER_WORKFLOW_STALE_AFTER_MS=90000
# BATTLE_WORKER_MAX_RETRIES=3
# BATTLE_AUTO_PROMOTE_INTERVAL_MS=300000
# BATTLE_FINALIZE_INTERVAL_MS=60000
# WEBHOOK_DRAIN_INTERVAL_MS=10000
# ASYNC_MEDIA_POLL_INTERVAL_MS=15000
# ASYNC_POLL_BATCH_LIMIT=10
# ASYNC_POLL_STALE_AFTER_SECONDS=30
