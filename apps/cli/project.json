{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/cli/src",
  "projectType": "application",
  "tags": ["scope:public", "license:oss"],
  "targets": {
    "build-app": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/cli",
        "format": ["esm"],
        "bundle": true,
        "main": "apps/cli/src/main.ts",
        "tsConfig": "apps/cli/tsconfig.app.json",
        "assets": [
          "apps/cli/src/assets",
          {
            "input": "apps/cli",
            "glob": "README.md",
            "output": "."
          },
          {
            "input": ".",
            "glob": "LICENSE",
            "output": "."
          }
        ],
        "generatePackageJson": true,
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          },
          "banner": {
            "js": "#!/usr/bin/env node\n;(function(){var r=process.version.match(/^v(\\d+)/);if(!r||+r[1]<22){process.stderr.write('\\nError: @lenserfight/cli requires Node.js v22 or newer (you have '+process.version+').\\nDownload the latest LTS from https://nodejs.org/en/download\\n\\n');process.exit(1);}})();"
          },
          "define": {
            "import.meta.env": "undefined"
          }
        }
      },
      "configurations": {
        "development": {},
        "production": {
          "esbuildOptions": {
            "sourcemap": false,
            "outExtension": {
              ".js": ".js"
            },
            "banner": {
              "js": "#!/usr/bin/env node\nimport{createRequire as __lfCreateRequire}from'module';if(typeof globalThis.require==='undefined'){globalThis.require=__lfCreateRequire(import.meta.url);}\n;(function(){var r=process.version.match(/^v(\\d+)/);if(!r||+r[1]<22){process.stderr.write('\\nError: @lenserfight/cli requires Node.js v22 or newer (you have '+process.version+').\\nDownload the latest LTS from https://nodejs.org/en/download\\n\\n');process.exit(1);}})();"
            },
            "define": {
              "import.meta.env": "undefined"
            }
          }
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [{ "target": "bundle-plugin", "projects": ["adapters-opencode"] }],
      "outputs": ["{workspaceRoot}/dist/apps/cli"],
      "options": {
        "parallel": false,
        "commands": [
          "pnpm nx run cli:build-app:production",
          "node tools/cli-release/copy-plugin.mjs"
        ]
      },
      "configurations": {
        "development": {
          "commands": [
            "pnpm nx run cli:build-app:development",
            "node tools/cli-release/copy-plugin.mjs"
          ]
        },
        "production": {}
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/cli/package.json",
        "{workspaceRoot}/dist/apps/cli/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build-app"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/cli/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build-app"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build-app"],
      "options": {
        "buildTarget": "cli:build-app",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "cli:build-app:development"
        },
        "production": {
          "buildTarget": "cli:build-app:production"
        }
      }
    },
    "strip-package-manager": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node -e \"const fs=require('fs'),p='dist/apps/cli/package.json',j=JSON.parse(fs.readFileSync(p,'utf8'));delete j.packageManager;fs.writeFileSync(p,JSON.stringify(j,null,2)+'\\n');\""
      }
    },
    "chmod": {
      "dependsOn": ["strip-package-manager"],
      "executor": "nx:run-commands",
      "options": {
        "command": "chmod 755 dist/apps/cli/main.js"
      }
    },
    "link": {
      "dependsOn": ["chmod"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd dist/apps/cli && npm link --force"
      }
    },
    "validate-package": {
      "dependsOn": ["chmod"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/cli/package-validation.json"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/cli-release/validate-package.mjs --package-dir dist/apps/cli"
      }
    },
    "smoke-install": {
      "dependsOn": ["validate-package"],
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/apps/cli/package-smoke.json"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/cli-release/smoke-install.mjs --package-dir dist/apps/cli"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
