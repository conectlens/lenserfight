{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run test *)",
      "Bash(npm run lint *)",
      "Read(.env.example)",
      "Read(./.env.example)",
      "Read(**/.env.example)"
    ],
    "deny": [
      "Read(.env)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(.env.local)",
      "Read(./.env.local)",
      "Read(**/.env.local)",
      "Read(.env.development)",
      "Read(./.env.development)",
      "Read(**/.env.development)",
      "Read(.env.development.local)",
      "Read(./.env.development.local)",
      "Read(**/.env.development.local)",
      "Read(.env.test)",
      "Read(./.env.test)",
      "Read(**/.env.test)",
      "Read(.env.test.local)",
      "Read(./.env.test.local)",
      "Read(**/.env.test.local)",
      "Read(.env.production)",
      "Read(./.env.production)",
      "Read(**/.env.production)",
      "Read(.env.production.local)",
      "Read(./.env.production.local)",
      "Read(**/.env.production.local)",
      "Read(**/secrets/**)",
      "Bash(env)",
      "Bash(printenv)",
      "Bash(export *)",
      "Bash(set)",
      "Bash(cat .env*)",
      "Bash(nc *)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ]
  },
  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  },
  "enabledPlugins": {}, 
 "teammateMode": "in-process"
}
